# Server only. Copy to .env.local; never commit real credentials.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://vet:CHANGE_ME@127.0.0.1:5432/vet
ADMIN_USER=admin
# At least 20 random characters; absent/short password disables administration.
ADMIN_PASSWORD=
# Required public origin behind HTTPS in production; no trailing slash.
APP_ORIGIN=http://localhost:3000
# Optional separate database for integration tests. Never use a production database.
TEST_DATABASE_URL=
E2E_DATABASE_URL=
# Public contact address for the collection User-Agent; required for live collection.
COLLECTOR_CONTACT=
# No scheduler is enabled. Collection is manual only.
